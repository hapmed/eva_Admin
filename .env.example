# EVAS Admin — variables de entorno
# IMPORTANTE: valores FICTICIOS de ejemplo. Los reales nunca se versionan.
# Ver docs/EVAS_ADMIN/SECURITY.md y docs/EVAS_ADMIN/POSTGRES_EXISTING_INSTANCE.md

# --- Entorno ---
EVAS_ENVIRONMENT=local
EVAS_DEBUG=false

# --- Base administrativa (instancia PostgreSQL EXISTENTE) ---
# Fase 2 NO abre conexión. No crear ni alterar el contenedor existente.
EVAS_DB_HOST=postgres.example.internal
EVAS_DB_PORT=5432
EVAS_DB_NAME=evas_admin
EVAS_DB_USER=evas_admin_app
EVAS_DB_PASSWORD=change-me-in-env
EVAS_DB_SSLMODE=prefer

# --- Sesión web (cookie) ---
EVAS_SESSION_COOKIE_NAME=evas_session
EVAS_SESSION_COOKIE_SECURE=false
EVAS_SESSION_COOKIE_SAMESITE=lax

# --- CORS (lista JSON de orígenes permitidos) ---
EVAS_CORS_ORIGINS=["http://localhost:5173"]

# --- Agente de operaciones ---
# simulated = no realiza cambios reales (por defecto). real = ejecuta en Docker.
EVAS_AGENT_MODE=simulated
EVAS_AGENT_TOKEN=dev-agent-token-change-me
# URL interna del agente para el backend (modo real).
EVAS_AGENT_URL=http://agent:8001

# --- Notificaciones por email (SMTP) ---
EVAS_SMTP_ENABLED=false
EVAS_SMTP_HOST=smtp.example.com
EVAS_SMTP_PORT=587
EVAS_SMTP_USER=evas-admin@example.com
EVAS_SMTP_PASSWORD=change-me-in-env
EVAS_SMTP_FROM=evas-admin@example.com
EVAS_SMTP_TO=["admin@example.com"]
EVAS_SMTP_STARTTLS=true
EVAS_SMTP_SSL=false

# --- Aprovisionamiento real (BD por cliente, contenedores, DNS) ---
EVAS_PROVISION_ENABLED=false
EVAS_PROVISION_DB_HOST=postgres
EVAS_PROVISION_DB_PORT=5432
EVAS_PROVISION_DB_ADMIN_USER=
EVAS_PROVISION_DB_ADMIN_PASSWORD=
EVAS_PROVISION_DB_ADMIN_DB=postgres
EVAS_PROVISION_USER_PREFIX=eva
EVAS_PORT_RANGE_START=9100
EVAS_PORT_RANGE_END=9199
EVAS_EVA_NETWORK=apps-net

# --- Cloudflare (publicar dominios de clientes) ---
EVAS_PUBLIC_DOMAIN_SUFFIX=hapmed.qzz.io
EVAS_CLOUDFLARE_API_TOKEN=
EVAS_CLOUDFLARE_ACCOUNT_ID=
EVAS_CLOUDFLARE_ZONE_ID=
EVAS_CLOUDFLARE_TUNNEL_ID=

# --- Frontend ---
VITE_API_BASE_URL=/api/v1
# URL interna de la API para el guard SSR del frontend (red Docker).
API_INTERNAL_URL=http://api:8000
